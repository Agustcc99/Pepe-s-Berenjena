# .gitignore para proyectos Unity
# Basado en https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Capturas de memoria y grabaciones (pueden pesar mucho)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Plugin de Rider
/[Aa]ssets/Plugins/Editor/JetBrains*

# Caches de IDE
.vs/
.idea/
.vscode/

# Gradle (builds de Android)
.gradle/

# Archivos generados por Unity para los IDE
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Metadatos generados
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Informes de crash
sysinfo.txt
crashlytics-build.properties

# Builds empaquetados
*.apk
*.aab
*.unitypackage
*.app

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Salida intermedia de Burst al compilar para WebGL
/Data/

# Salida intermedia de CMake/Ninja al compilar para Android (GameActivity)
/.utmp/
