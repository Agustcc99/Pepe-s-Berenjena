  <assembly fullname="FarmIdle.Data" preserve="all" />
  <assembly fullname="FarmIdle.Managers" preserve="all" />
  <assembly fullname="FarmIdle.Environment" preserve="all" />
  <assembly fullname="FarmIdle.Player" preserve="all" />
  <assembly fullname="FarmIdle.UI" preserve="all" />
</linker>
